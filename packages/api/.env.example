# Copie este arquivo para .env e ajuste os valores.
# Validado em runtime por src/config/env.schema.ts (Zod) via ConfigModule.

NODE_ENV=development
PORT=3000

# Duas roles de Postgres distintas — ver docker/postgres/init.sql e o
# GRANT dentro da migration que cria User/Role/AuditLog. Nunca use
# DATABASE_URL (owner) pra servir requisições — RLS não isola nada se a
# conexão em runtime for a dona das tabelas.
DATABASE_URL="postgresql://adts_owner:adts_owner@localhost:5434/adts?schema=public"
RUNTIME_DATABASE_URL="postgresql://adts_app:adts_app@localhost:5434/adts?schema=public"

# Redis local (ver docker-compose.yml na raiz do monorepo)
REDIS_URL="redis://localhost:6379"

# Troque por segredos reais fora de desenvolvimento.
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao"
