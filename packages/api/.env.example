# Copie este arquivo para .env e ajuste os valores.
# Validado em runtime por src/config/env.schema.ts (Zod) via ConfigModule.

NODE_ENV=development
PORT=3000

# Postgres local (ver docker-compose.yml na raiz do monorepo)
DATABASE_URL="postgresql://adts:adts@localhost:5433/adts?schema=public"

# Redis local (ver docker-compose.yml na raiz do monorepo)
REDIS_URL="redis://localhost:6379"
